{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cantonese-biz-dual-model-api",
  "main": "cloudflare/src/index.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://dragon-zhang-woo.github.io",
    "PUBLIC_AI_BUDGET_CNY": "5",
    "PUBLIC_AI_ESTIMATED_TURN_COST_CNY": "0.05",
    "PUBLIC_AI_TURNS_PER_CLIENT": "5",
    "PROVIDER_TIMEOUT_MS": "30000",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DEEPSEEK_MODEL": "deepseek-v4-pro",
    "HKCHAT_BASE_URL": "https://test-new-api.hkchat.app",
    "HKCHAT_MODEL": "t2_hkgai-v3_fp8_1m_e7"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cantonese-biz-public-budget",
      "database_id": "771cfad3-66b3-4ad5-acb4-635452f656d1",
      "migrations_dir": "cloudflare/migrations"
    }
  ]
}
