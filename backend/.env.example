# Copy this file to backend/.env and fill secrets there.
# Never commit backend/.env or paste real credentials into documentation.

# Dual-model runtime. AI_PROVIDER remains only for older local setups.
AI_PROVIDER=mock
AI_SCENE_PROVIDER=deepseek
AI_LOCALIZE_PROVIDER=hkchat
ALLOW_OFFLINE_FALLBACK=true
AI_CACHE_TTL_SECONDS=600
AI_CACHE_MAX_ENTRIES=64

# DeepSeek (one API key can access the models enabled for the account)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# HKGAI / HKChat text MaaS (OpenAI-compatible)
# The same API key is used for every text model returned by GET /v1/models.
HKCHAT_API_KEY=
HKCHAT_BASE_URL=https://test-new-api.hkchat.app
HKCHAT_MODEL=t2_hkgai-v3_fp8_1m_e7
HKCHAT_ENABLE_THINKING=false
HKCHAT_REASONING_EFFORT=none

# HKGAI / HKChat speech service.
# Speech capabilities remain disabled until the organiser supplies and you set
# the exact file-transcription and/or real-time WebSocket endpoint. The public
# product page confirms Cantonese support but does not publish this contract;
# HKCHAT_SPEECH_BASE_URL alone therefore does not enable speech.
HKCHAT_SPEECH_API_KEY=
HKCHAT_SPEECH_BASE_URL=https://openspeech.hkgai.net
HKCHAT_SPEECH_HTTP_URL=
HKCHAT_SPEECH_WS_URL=
# bearer or basic; use only the mode stated in the supplied contract.
HKCHAT_SPEECH_AUTH_MODE=bearer
HKCHAT_SPEECH_USERNAME=
HKCHAT_SPEECH_PASSWORD=

# HKGAI Toolhub (App-Name / App-Key authentication)
HKCHAT_TOOLHUB_APP_NAME=
HKCHAT_TOOLHUB_APP_KEY=
HKCHAT_TOOLHUB_BASE_URL=https://toolhub.prod.hkchat.app

# HKGAI Agenthub. The portal states these credentials are shared with Toolhub.
# Keep separate slots here so the configuration remains explicit and can support
# separate credentials later if the platform changes.
HKCHAT_AGENTHUB_APP_NAME=
HKCHAT_AGENTHUB_APP_KEY=
HKCHAT_AGENTHUB_BASE_URL=https://search-agent.prod.hkchat.app/v1

# Browser origins allowed to call the local backend
ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
